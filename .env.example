# ctrl-ai environment. Copy to .env and fill in; .env is never committed.
# Compose reads this file only to fill in the ${...} placeholders in deploy/docker/compose.yml.
# A variable exported in your shell overrides the value here.

# The gateway key clients present. Required. Replace with a random value, e.g.
#   echo "sk-ctrl-ai-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-ctrl-ai-change-me

# Anthropic Console API key. Only needed for provider-key mode; leave empty for subscription pass-through.
ANTHROPIC_API_KEY=

# Where the gateway sends Anthropic traffic: a bare origin, no /v1. Empty means the real API, so keep it explicit.
ANTHROPIC_API_BASE=https://api.anthropic.com

# Which LiteLLM config to load. Use /app/gateway/config.infra-only.yaml to run without the guardrail and logger.
CTRL_AI_GATEWAY_CONFIG=/app/gateway/config.yaml

# Policy file path inside the container.
CTRL_AI_POLICY_FILE=/app/config/policy.yaml

# Audit log path inside the container (logs/audit.jsonl on the host).
CTRL_AI_AUDIT_LOG=/app/logs/audit.jsonl

# Jev key. Only needed for Jev verdicts; while empty, Jev reports "disabled" and requests still pass.
JEV_API_KEY=

# Full Jev endpoint.
JEV_URL=https://api.typesafe.ai/v1/systemone

# Per-call Jev timeout in seconds.
JEV_TIMEOUT_S=2.0

# Jev model name, pinned to a version.
JEV_MODEL=jev-1.13.0

# Mistral API key (free "Experiment" tier) for the gateway model chat-mistral.
MISTRAL_API_KEY=

# Groq API key (free tier) for the gateway model chat-groq and the default judge.
GROQ_API_KEY=

# Address the admin panel listens on. 127.0.0.1 = this machine only. 0.0.0.0 = every interface,
# which makes it reachable from the LAN and from the Tailscale subnet route to it. The UI has no login.
CTRL_AI_UI_BIND=127.0.0.1

# ---- Admin panel ----
# Admin panel login: not used yet (the panel runs as "local-admin" without sign-in, CSRF still required; single sign-on plugs in at ctrl_ai.admin.auth.current_admin). Kept for a future login; may stay empty.
CTRL_AI_ADMIN_USER=admin
CTRL_AI_ADMIN_PASSWORD=
CTRL_AI_SESSION_SECRET=
# Signs break-glass override tokens (scripts/break-glass.py and the gateway). Without it break-glass is refused.
# Generate once:  openssl rand -hex 24   (paste the output here; never commit or share it)
CTRL_AI_BREAKGLASS_SECRET=
# Keys the per-session masking pseudonyms and encrypts the restore map. Without it masking is OFF and personal
# identifiers are sent as they are. Generate once:  openssl rand -hex 24   (keep it stable: changing it
# changes the pseudonyms and makes open sessions' maps unreadable)
CTRL_AI_MASKING_SECRET=
# Decision models per role. A spec is "jev", "none" or a LiteLLM model string.
# The classifier scores every request; a LiteLLM classifier uses the API base and timeout below.
CTRL_AI_CLASSIFIER_MODEL=jev
CTRL_AI_CLASSIFIER_API_BASE=
CTRL_AI_CLASSIFIER_TIMEOUT_S=8
# The judge: confirms the classifier, decides when it is off or down. The default uses GROQ_API_KEY.
# For a local OpenAI-compatible server (Ollama, vLLM, LM Studio): openai/<model> plus its /v1 API base.
CTRL_AI_JUDGE_MODEL=groq/openai/gpt-oss-safeguard-20b
CTRL_AI_JUDGE_API_BASE=
CTRL_AI_JUDGE_TIMEOUT_S=8
# The shadow check's model; empty uses the judge's model, API base and timeout.
CTRL_AI_SHADOW_MODEL=
# Host ports (change to run a second stack side by side).
CTRL_AI_GATEWAY_PORT=4000
CTRL_AI_UI_PORT=4100
# User and group id the admin container runs as, so the files it writes stay yours. make uses your
# own ids (id -u, id -g) by default; set these only to run it as someone else.
# CTRL_AI_UID=1000
# CTRL_AI_GID=1000
