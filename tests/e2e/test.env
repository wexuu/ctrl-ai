# Fake values only. Used with `docker compose --env-file tests/e2e/test.env`, which replaces .env
# completely, so a real key can never reach a test run.
LITELLM_MASTER_KEY=sk-ctrl-ai-test-master
ANTHROPIC_API_KEY=sk-ant-test-dummy
ANTHROPIC_API_BASE=http://stub-anthropic:9001
JEV_API_KEY=jev-test-key
JEV_URL=http://stub-jev:9002/v1/systemone
JEV_TIMEOUT_S=2.0
JEV_MODEL=jev-1.13.0
CTRL_AI_GATEWAY_CONFIG=/app/gateway/config.yaml
CTRL_AI_POLICY_FILE=/app/runtime/policy.yaml
CTRL_AI_AUDIT_LOG=/app/runtime/audit.jsonl
CTRL_AI_UI_MODELS=claude-haiku-4-5
MISTRAL_API_KEY=
GROQ_API_KEY=
# Fake values only.
CTRL_AI_KEYS_FILE=/app/runtime/state/keys.json
CTRL_AI_BREAKGLASS_FILE=/app/runtime/state/break_glass.json
CTRL_AI_BREAKGLASS_SECRET=ctrl-ai-test-breakglass-secret
CTRL_AI_MASKING_SECRET=ctrl-ai-test-masking-secret
CTRL_AI_JUDGE_MODEL=anthropic/claude-haiku-4-5
CTRL_AI_JUDGE_API_BASE=http://stub-anthropic:9001
CTRL_AI_JUDGE_TIMEOUT_S=5
CTRL_AI_REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Config copies the tests may rewrite (prepare_runtime.py copies them from config/).
CTRL_AI_MODELS_FILE=/app/runtime/models.yaml
CTRL_AI_TEAMS_FILE=/app/runtime/teams.yaml
CTRL_AI_SIGNATURES_FILE=/app/runtime/signatures.yaml
CTRL_AI_MCP_FILE=/app/runtime/mcp.yaml
